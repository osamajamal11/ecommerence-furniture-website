{
  "name": "hearth-and-form",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test": "node --test tests/*.test.js",
    "db:generate": "drizzle-kit generate",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
